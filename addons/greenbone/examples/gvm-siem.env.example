# gvm-siem-push settings
# Copy to /etc/gvm-siem/gvm-siem.env (or anywhere you like), fill in the values in angle brackets, 
# then: chmod 600 /etc/gvm-siem/gvm-siem.env
# Never commit the real file.

# --- Greenbone -------------------------------------------------------------
# Default socket path for the Greenbone Community Docker Compose install.
# Find yours with: sudo find / -name gvmd.sock 2>/dev/null
GVM_SOCKET=/var/lib/docker/volumes/greenbone-community-edition_gvmd_socket_vol/_data/gvmd.sock
GVM_USERNAME=<greenbone user>
GVM_PASSWORD=<greenbone password>

# --- Elasticsearch ---------------------------------------------------------
ES_HOST=https://<elasticsearch-host>:9200
# Login: an API key (recommended), or a username and password.
# ES_API_KEY=<base64 API key>
ES_USERNAME=<elasticsearch user>
ES_PASSWORD=<elasticsearch password>
ES_INDEX=gvm-vulnerabilities

# CA certificate that signed Elasticsearch's TLS certificate (recommended).
ES_CA_CERTS=/etc/gvm-siem/elastic-ca.crt
# Only if no CA certificate is available (the connection is then not verified):
# ES_VERIFY_CERTS=false

# Set to 8 when the Python client is newer than an Elasticsearch 8 server.
# ES_COMPAT_VERSION=8

# --- What to send ----------------------------------------------------------
# MIN_SEVERITY=0.0
# MIN_QOD=70
# APPLY_OVERRIDES=true
# COMPARE_PREVIOUS=true
# GVM_TIMEOUT=600

# --- Files -----------------------------------------------------------------
STATE_FILE=/var/lib/gvm-siem/last_run
LOG_FILE=/var/log/gvm-siem/push.log
# LOG_LEVEL=INFO
