[Unit]
Description=SIEM feedback poller (reads Google Sheet, runs judge, updates SYSTEM_MEMORY.md)
Documentation=https://github.com/cylab-africa/Siem-Maintenance-Agent-Monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/siem-maint/Agent-SIEM-maintenance
User=siem-maint
Group=siem-maint
EnvironmentFile=/etc/siem-maint/env
ExecStart=/opt/siem-maint/venv/bin/python /opt/siem-maint/Agent-SIEM-maintenance/feedback_poller.py --loop 60
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=siem-feedback-poller

[Install]
WantedBy=multi-user.target
