# Alert Triage Agent (optional add-on)
# ====================================
# Built from the repository root so it can be driven by docker/docker-compose.yml:
#   docker compose --env-file .env -f docker/docker-compose.yml --profile triage up -d
#
# Source lives in addons/alert-triage (git subtree of
# https://github.com/masterlion-hash/Alert-Triage-Agent).
#
# The agent has no authentication of its own. The compose service publishes it
# on 127.0.0.1 only unless TRIAGE_BIND is set; see docs/add-ons.md before widening it.

FROM python:3.12-slim

LABEL description="Alert Triage Agent: AI-assisted investigation of Elastic Security alerts (UI, API, MCP)"

RUN groupadd -r triage && useradd -r -g triage -d /app triage

WORKDIR /app

COPY addons/alert-triage/requirements.txt requirements.txt
COPY addons/alert-triage.constraints.txt constraints.txt
RUN pip install --no-cache-dir -r requirements.txt -c constraints.txt

# .env, certs/ and .venv are excluded by .dockerignore; configuration comes from
# env_file and the certs/ bind mount. assets.yml is baked in when present.
COPY addons/alert-triage/ ./

RUN chown -R triage:triage /app

USER triage

EXPOSE 8000

HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\", \"8000\")}/health', timeout=4)"

CMD ["python", "server.py"]
