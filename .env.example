# /etc/siem-maint/env — siem_maint runtime configuration
#
# Copy this file to /etc/siem-maint/env and edit. The systemd unit
# (deploy/siem-maint.service) sources it via `EnvironmentFile=`.
# Changes take effect on `systemctl reload siem-maint` (sends SIGHUP).
#
# Permissions: 640, owned root:siem-maint.
# See docs/09 §Step 5 for the full deployment context.

# ─── Elasticsearch connection ────────────────────────────────────────
ES_HOST=https://es.example.internal:9200

# Authentication — choose ONE method (ES_API_KEY takes precedence if set)
#
# Option A: API Key (recommended)
#   Kibana → Stack Management → Security → API Keys → Create API key
#   Copy the "Encoded" value (long base64 string) and paste below.
#   Keys are revocable without changing cluster passwords.
ES_API_KEY=
ES_AUTH_TYPE=apikey
#
# Option B: Username / Password
# ES_AUTH_TYPE=userpass
ES_USERNAME=siem-maint-svc
ES_PASSWORD=

# ─── Elasticsearch TLS — choose ONE strategy ────────────────────────
# Recommended: internal CA bundle on disk
ES_CA_CERT=/etc/ssl/certs/internal-ca.pem
ES_VERIFY_CERTS=true

# Lab only: disables verification entirely (logs a warning on startup)
# ES_VERIFY_CERTS=false

# ─── Google Chat — infrastructure maintenance space ───────────────────
CHAT_WEBHOOK=

# ─── LLM (daily report + health alerts) ──────────────────────────────
#  gpt-* model id + OPENAI_API_KEY → OpenAI Chat API
#  any other LLM_MODEL → Ollama at OLLAMA_URL (/api/generate)
#  LLM_ENABLED=false → skip all LLM calls (metrics + Chat still run)
# LLM_ENABLED=true
# LLM_MODEL=llama3.2
# ES_HEALTH_LLM_MODEL=llama3.2
# OLLAMA_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=

# Optional Google Chat action buttons (HTTPS only).
# GC_ALERT_SSH_URL=https://example.com/runbook#ssh
# GC_ALERT_COMMANDS_URL=https://example.com/runbook
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# ─── Feedback loop (closed-loop learning) ───────────────────────────
# Set GOOGLE_CHAT_VERIFICATION_TOKEN to enable interactive feedback
# buttons on alert cards. Leave blank for one-way webhook mode.
# GOOGLE_CHAT_VERIFICATION_TOKEN=
# Send cards as the registered Chat App (enables button callbacks):
# GOOGLE_CHAT_SA_KEY=/abs/path/to/siem-chat-bot-key.json
# GOOGLE_CHAT_SPACE_ID=spaces/XXXXXXXX
# Cloud Function base URL backing the "Custom Instruction" web form:
# FEEDBACK_FORM_URL=https://chat-feedback-XXXX-uc.a.run.app
# FEEDBACK_SHEET_ID=<google sheet id that the Apps Script + poller use>
FEEDBACK_SERVER_PORT=8090
FEEDBACK_PROMOTION_THRESHOLD=2
FEEDBACK_CONTEXT_TTL_HOURS=72

# ─── Scheduler ──────────────────────────────────────────────────────
# Daily report wall clock (HH:MM in MAINTENANCE_IANA_TIMEZONE)
DAILY_REPORT_TIME_CAT=08:30
# When set, auto-remediation runs daily at this time instead of an interval
AUTO_REMEDIATION_TIME=08:35
# Comma-separated alert scenarios to silence (e.g. "ingest")
# ES_HEALTH_DISABLED_SCENARIOS=ingest

# ─── Tunables (defaults match docs/06) ──────────────────────────────
ES_ALERT_COOLDOWN_HOURS=4
DATA_FRESHNESS_CRITICAL_HOURS=3
HOST_CPU_CRITICAL_PERCENT=90
