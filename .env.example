# .env.example — Copy to .env and fill in your values
# ==================================================

# DAGSHUB MLFLOW CONFIGURATION (optional)
# ========================================
DAGSHUB_REPO_NAME=your-repo-name
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_TOKEN=your-dagshub-token

# ELASTICSEARCH CONFIGURATION (required)
# =======================================
ES_HOST=https://your-elasticsearch-host:9200
ES_USERNAME=your-es-username
ES_PASSWORD=your-es-password

# Elasticsearch index patterns for different data types
ES_PROCESS_INDEX=.ds-logs-endpoint.events.process-default-*
ES_NETWORK_INDEX=.ds-logs-endpoint.events.network-default-*
ES_DISCOVERY_INDEX=logs-endpoint.events.process-*
ES_METADATA_INDEX=logs-endpoint.events.process-*,logs-endpoint.events.network-*
ES_ALERTS_INDEX=.internal.alerts-security.alerts-default-*

# Elasticsearch performance settings
ES_SCROLL_SIZE=10000
ES_SCROLL_TIMEOUT=2m
ES_TIMEOUT=60

# TRAINING CONFIGURATION
# =======================
TRAINING_PERIOD_DAYS=5
BASELINE_QUERY_SIZE=2000000
TRAINING_START_OFFSET_DAYS=1
TRAINING_END_OFFSET_DAYS=0
PROCESS_TRAINING_PERIOD_DAYS=7
NETWORK_TRAINING_PERIOD_DAYS=5
DISCOVERY_TRAINING_PERIOD_DAYS=5
METADATA_TRAINING_PERIOD_DAYS=5
ALERTS_TRAINING_PERIOD_DAYS=90

# DETECTION CONFIGURATION
# ========================
TIME_WINDOW=2
THRESHOLD_MULTIPLIER=3.0
MIN_BASELINE_PERIOD=30
AGGREGATION_INTERVAL=15min
BUCKET_SPAN=15m
SENSITIVITY=0.3

# Anomaly detection methods
ANOMALY_METHODS=isolation_forest,lof,ocsvm,pca

# Data group specific thresholds
RARE_PROCESS_THRESHOLD=0.1
RARE_PROCESS_HOST_THRESHOLD=0.05
RARE_USER_THRESHOLD=0.5
RARE_SUDO_THRESHOLD=1.0
RARE_COMPILER_THRESHOLD=2.0
DISCOVERY_THRESHOLD=5.0
RARE_METADATA_PROCESS_THRESHOLD=1.0
RARE_METADATA_USER_THRESHOLD=2.0

# MACHINE LEARNING CONFIGURATION
# ================================
ML_FEATURE_SELECTION=enhanced
ML_CONTAMINATION=0.05
ML_N_ESTIMATORS=100
ML_LOF_NEIGHBORS=20
ML_SVM_KERNEL=rbf
ML_PCA_COMPONENTS=0.95

# REALTIME SERVICE CONFIGURATION (optional, realtime_service.py only)
# ====================================================================
# Values shown are the built-in defaults; uncomment to override.

# Seconds between detection cycles
#DETECTION_INTERVAL_SECONDS=300

# Hours between background retrains (RETRAIN_INTERVAL_DAYS also accepted)
#RETRAIN_INTERVAL_HOURS=72

# How often the service prunes its own output, and what it keeps
#ML_CLEANUP_INTERVAL_HOURS=1
#RESULT_ARTIFACT_MAX_AGE_HOURS=72
#RESULT_ARTIFACT_MAX_FILES=6000
#STALE_LOG_MAX_AGE_HOURS=24

# OUTPUT CONFIGURATION
# =====================
SAVE_RESULTS=true
VISUALIZATION=true
GENERATE_REPORTS=true
SAVE_MODELS=true
RESULTS_DIR=./results
MODELS_DIR=./results/models
REPORTS_DIR=./results/reports
VISUALIZATIONS_DIR=./results/visualizations
LOGS_DIR=./logs

# LOGGING CONFIGURATION
# ======================
LOG_LEVEL=INFO
CONSOLE_OUTPUT=true

# PERFORMANCE CONFIGURATION
# ==========================
MAX_WORKERS=4
CHUNK_SIZE=1000
MEMORY_LIMIT=4GB
ENABLE_PARALLEL_PROCESSING=true
CACHE_ENABLED=true

# ALERT CONFIGURATION (optional)
# ================================
ALERTS_ENABLED=false
CRITICAL_THRESHOLD=0.9
HIGH_THRESHOLD=0.7
MEDIUM_THRESHOLD=0.5
LOW_THRESHOLD=0.2

# Email notifications (optional)
EMAIL_ENABLED=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=

# Slack notifications (optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts
